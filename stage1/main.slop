# stage1/main.slop — dumps a token stream, in the C lexer's exact format.
#
# The format is copied deliberately: `slop --tokens f.slop` and
# `stage1-lex f.slop` must produce byte-identical output on every input, and
# that diff is the only honest measure of whether the port is correct.

# C's stderr is a macro over a global, and a slop extern block declares
# functions only, so the stream is opened on the file descriptor instead.
# It is flushed after every write because this one is buffered where C's
# stderr is not, and the order diagnostics appear in matters.
let mut void* g_stderr = null;
let mut b8 g_check = false;

fn err() -> void* {
    if g_stderr == null {
        g_stderr = fdopen(2, "w");
    }
    return g_stderr;
}

fn read_file(u8* path, i64* out_len) -> u8* {
    let void* f = fopen(path, "rb");
    if f == null {
        fprintf(err(), "stage1: cannot open %s\n", path);
        fflush(err());
        return null;
    }

    fseek(f, 0, 2);          # SEEK_END
    let i64 size = ftell(f);
    rewind(f);
    if size < 0 {
        fclose(f);
        return null;
    }

    let u8* buf = malloc((size + 1).as(u64)).as(u8*);
    let u64 got = fread(buf.as(void*), 1, size.as(u64), f);
    fclose(f);
    buf[got.as(i64)] = 0;
    *out_len = got.as(i64);
    return buf;
}

fn print_escaped(u8* s, i32 len) -> void {
    let mut i32 i = 0;
    while i < len {
        let u8 c = s[i];
        if c == 10 {
            printf("\\n");
        } else {
            if c == 13 {
                printf("\\r");
            } else {
                if c == 9 {
                    printf("\\t");
                } else {
                    if c == 0 {
                        printf("\\0");
                    } else {
                        if c == 92 {
                            printf("\\\\");
                        } else {
                            if c == 34 {
                                printf("\\\"");
                            } else {
                                if c >= 0x20 && c < 0x7F {
                                    printf("%c", c.as(i32));
                                } else {
                                    printf("\\x%02X", c.as(i32));
                                }
                            }
                        }
                    }
                }
            }
        }
        i += 1;
    }
}

fn dump_token(u8* file, Token* t) -> void {
    if t.kind == TOK_ERROR.as(i32) {
        fprintf(err(), "%s:%d:%d: error: %s\n", file, t.line, t.col, t.sval);
        fflush(err());
        return;
    }

    printf("%4d:%-3d %-16s ", t.line, t.col, token_kind_name(t.kind));

    if t.kind == TOK_INT.as(i32) {
        printf("%.*s  = %llu", t.len, t.text, t.ival);
    }
    if t.kind == TOK_FLOAT.as(i32) {
        printf("%.*s  = %g", t.len, t.text, t.fval);
    }
    if t.kind == TOK_CHAR.as(i32) {
        printf("%.*s  = %llu", t.len, t.text, t.ival);
    }
    if t.kind == TOK_STRING.as(i32) {
        printf("%.*s  = \"", t.len, t.text);
        print_escaped(t.sval, t.slen);
        printf("\" (%d bytes)", t.slen);
    }
    if t.kind != TOK_INT.as(i32) && t.kind != TOK_FLOAT.as(i32) && t.kind != TOK_CHAR.as(i32)
        && t.kind != TOK_STRING.as(i32) && t.kind != TOK_EOF.as(i32) {
        printf("%.*s", t.len, t.text);
    }
    printf("\n");
}

fn lex_file(u8* path) -> i32 {
    let mut i64 len = 0;
    let u8* src = read_file(path, &len);
    if src == null {
        return 1;
    }

    let mut Lexer l;
    lexer_init(&l, path, src, len);

    let mut Token t;
    let mut i32 count = 0;
    let mut b8 done = false;
    while !done {
        lex_next(&l, &t);
        dump_token(path, &t);
        count += 1;
        if t.kind == TOK_EOF.as(i32) {
            done = true;
        }
    }

    printf("%s: %d tokens, %d error(s)\n", path, count, l.errors);
    if l.errors != 0 {
        return 1;
    }
    return 0;
}

# Parses a file and reports what it found. Not the AST dump yet: matching
# the C dumper byte for byte is the next step, and until then the check is
# that both parsers agree on which files are well formed and on how many
# items each has.
fn parse_file(u8* path) -> i32 {
    let mut i64 len = 0;
    let u8* src = read_file(path, &len);
    if src == null {
        return 1;
    }

    let mut Lexer l;
    lexer_init(&l, path, src, len);

    let mut Token* toks = null;
    let mut i32 ntoks = 0;
    lex_all(&l, &toks, &ntoks);

    let Arena* arena = arena_new(262144);
    let mut Parser p;
    p.toks = toks;
    p.ntoks = ntoks;
    p.pos = 0;
    p.arena = arena;
    p.file = path;
    p.errors = 0;

    let mut Program prog;
    let i32 errors = parse_program(&p, &prog);
    if errors != 0 {
        fprintf(err(), "%d error(s)\n", errors);
        fflush(err());
        return 1;
    }
    if g_check {
        let i32 sema_errors = sema_check(arena, &prog);
        if sema_errors != 0 {
            fprintf(err(), "%d error(s)\n", sema_errors);
            fflush(err());
            return 1;
        }
        return 0;
    }
    ast_dump(&prog);
    return 0;
}

# Builds types through the ported universe and prints their layout, so it can
# be checked against what the C compiler computes for the same declarations.
# Layout is a language guarantee, so agreement here is not a nicety.
fn types_check() -> i32 {
    let Arena* arena = arena_new(65536);
    let mut TypeTable tt;
    types_init(&tt, arena);

    let Ty* i32t = ty_core(&tt, TY_I32.as(i32));
    let Ty* i64t = ty_core(&tt, TY_I64.as(i32));
    let Ty* u8t = ty_core(&tt, TY_U8.as(i32));

    printf("i32       size=%u align=%u\n", i32t.size, i32t.align);
    printf("i32*      size=%u align=%u\n", ty_ptr(&tt, i32t).size, ty_ptr(&tt, i32t).align);
    printf("i32[10]   size=%u align=%u\n", ty_array(&tt, i32t, 10).size,
           ty_array(&tt, i32t, 10).align);
    printf("u8[3]     size=%u align=%u\n", ty_array(&tt, u8t, 3).size,
           ty_array(&tt, u8t, 3).align);

    # Interning: asking twice must give the same object, or `a == b` stops
    # being type equality.
    if ty_ptr(&tt, i32t) == ty_ptr(&tt, i32t) {
        printf("interned  yes\n");
    } else {
        printf("interned  NO\n");
    }

    # struct { u8 a; i64 b; i32 c; } -- padded to 24 with b at 8 and c at 16.
    let FieldSym* fields = arena_alloc(arena, 3 * sizeof(FieldSym)).as(FieldSym*);
    fields[0].name = "a";
    fields[0].name_len = 1;
    fields[0].type = u8t;
    fields[1].name = "b";
    fields[1].name_len = 1;
    fields[1].type = i64t;
    fields[2].name = "c";
    fields[2].name_len = 1;
    fields[2].type = i32t;

    let Ty* st = ty_struct_new(&tt, "Padded", 6, null);
    ty_layout_struct(st, fields, 3);
    printf("Padded    size=%u align=%u a@%u b@%u c@%u\n", st.size, st.align,
           st.fields[0].offset, st.fields[1].offset, st.fields[2].offset);
    return 0;
}

fn main(i32 argc, u8** argv) -> i32 {
    if argc < 2 {
        fprintf(err(), "usage: stage1-lex <file.slop>...\n");
        fflush(err());
        return 2;
    }

    let mut i32 failed = 0;
    let mut b8 do_parse = false;
    let mut b8 do_types = false;
    let mut i32 i = 1;
    while i < argc {
        if argv[i][0] == '-' {
            if argv[i][2] == 't' {
                do_types = true;
            } else {
                if argv[i][2] == 'c' {
                    g_check = true;
                }
                do_parse = true;
            }
        }
        i += 1;
    }

    if do_types {
        return types_check();
    }

    i = 1;
    while i < argc {
        if argv[i][0] != '-' {
            if do_parse {
                failed |= parse_file(argv[i]);
            } else {
                failed |= lex_file(argv[i]);
            }
        }
        i += 1;
    }
    return failed;
}
