# stage1/dump.slop — the AST dumper, in slop.
#
# This exists to make the parser checkable. The dump is the only externally
# visible statement of how a program was parsed, so once this matches the C
# dumper byte for byte, diffing the two says something about the *shape* of
# the tree rather than about how many items are in it.
#
# The format is not designed here; it is copied, down to the two-space
# indent and the pluralisation of "1 arg". Every deviation is a false
# difference that has to be chased, so there is nothing to gain by improving
# it while the goal is agreement.

fn indent(i32 depth) -> void {
    let mut i32 i = 0;
    while i < depth {
        printf("  ");
        i += 1;
    }
}

fn print_name(u8* text, i32 len) -> void {
    if text == null {
        printf("<none>");
        return;
    }
    printf("%.*s", len, text);
}

fn print_quoted(u8* s, i32 len) -> void {
    printf("\"");
    let mut i32 i = 0;
    while i < len {
        let u8 c = s[i];
        if c == 10 {
            printf("\\n");
        } else {
            if c == 13 {
                printf("\\r");
            } else {
                if c == 9 {
                    printf("\\t");
                } else {
                    if c == 34 {
                        printf("\\\"");
                    } else {
                        if c == 92 {
                            printf("\\\\");
                        } else {
                            # isprint, as C's dumper spells it: printable
                            # ASCII goes through, anything else is escaped.
                            if c >= 0x20 && c < 0x7F {
                                printf("%c", c.as(i32));
                            } else {
                                printf("\\x%02X", c.as(i32));
                            }
                        }
                    }
                }
            }
        }
        i += 1;
    }
    printf("\"");
}

fn print_type(Type* t) -> void {
    if t == null {
        printf("<error-type>");
        return;
    }
    match t.kind {
        TYPE_CORE => printf("%s", token_kind_name(t.core));
        TYPE_NAME => print_name(t.name, t.name_len);
        TYPE_POINTER => {
            print_type(t.elem);
            printf("*");
        }
        TYPE_ARRAY => {
            print_type(t.elem);
            printf("[%llu]", t.length);
        }
        _ => printf("<error-type>");
    }
}

fn dump_expr(Expr* e, i32 depth) -> void {
    indent(depth);
    if e == null {
        printf("<error-expr>\n");
        return;
    }

    match e.kind {
        EXPR_INT => {
            printf("int %llu\n", e.as(ExprLit*).ival);
        }
        EXPR_FLOAT => {
            printf("float %g\n", e.as(ExprLit*).fval);
        }
        EXPR_CHAR => {
            printf("char %llu\n", e.as(ExprLit*).ival);
        }
        EXPR_STRING => {
            printf("string ");
            print_quoted(e.as(ExprText*).text, e.as(ExprText*).len);
            printf("\n");
        }
        EXPR_BOOL => {
            if e.as(ExprLit*).ival != 0 {
                printf("bool true\n");
            } else {
                printf("bool false\n");
            }
        }
        EXPR_NULL => printf("null\n");
        EXPR_NAME => {
            printf("name ");
            print_name(e.as(ExprText*).text, e.as(ExprText*).len);
            printf("\n");
        }
        EXPR_UNARY => {
            let ExprUnary* u = e.as(ExprUnary*);
            printf("unary %s\n", token_kind_name(u.op));
            dump_expr(u.operand, depth + 1);
        }
        EXPR_BINARY => {
            let ExprBinary* b = e.as(ExprBinary*);
            printf("binary %s\n", token_kind_name(b.op));
            dump_expr(b.lhs, depth + 1);
            dump_expr(b.rhs, depth + 1);
        }
        EXPR_CALL => {
            let ExprCall* c = e.as(ExprCall*);
            if c.nargs == 1 {
                printf("call (1 arg)\n");
            } else {
                printf("call (%u args)\n", c.nargs);
            }
            dump_expr(c.callee, depth + 1);
            let mut i32 i = 0;
            while i < c.nargs {
                dump_expr(c.args[i], depth + 1);
                i += 1;
            }
        }
        EXPR_INDEX => {
            let ExprIndex* x = e.as(ExprIndex*);
            printf("index\n");
            dump_expr(x.base, depth + 1);
            dump_expr(x.index, depth + 1);
        }
        EXPR_FIELD => {
            let ExprField* f = e.as(ExprField*);
            printf("field .");
            print_name(f.name, f.name_len);
            printf("\n");
            dump_expr(f.base, depth + 1);
        }
        EXPR_CAST => {
            let ExprType* c = e.as(ExprType*);
            printf("cast to ");
            print_type(c.type);
            printf("\n");
            dump_expr(c.operand, depth + 1);
        }
        EXPR_SIZEOF => {
            let ExprType* s = e.as(ExprType*);
            printf("sizeof ");
            print_type(s.type);
            printf("\n");
        }
        _ => printf("<error-expr>\n");
    }
}

fn dump_block(Stmt* s, i32 depth) -> void {
    let StmtBlock* b = s.as(StmtBlock*);
    indent(depth);
    printf("block (%u)\n", b.nstmts);
    let mut i32 i = 0;
    while i < b.nstmts {
        dump_stmt(b.stmts[i], depth + 1);
        i += 1;
    }
}

fn dump_stmt(Stmt* s, i32 depth) -> void {
    if s == null {
        indent(depth);
        printf("<error-stmt>\n");
        return;
    }

    match s.kind {
        STMT_BLOCK => dump_block(s, depth);
        STMT_EMPTY => {
            indent(depth);
            printf("empty\n");
        }
        STMT_VAR => {
            let StmtVar* v = s.as(StmtVar*);
            indent(depth);
            printf("let ");
            if v.is_mut != 0 {
                printf("mut ");
            }
            print_type(v.type);
            printf(" ");
            print_name(v.name, v.name_len);
            printf("\n");
            if v.init != null {
                dump_expr(v.init, depth + 1);
            }
        }
        STMT_IF => {
            let StmtIf* f = s.as(StmtIf*);
            indent(depth);
            printf("if\n");
            dump_expr(f.cond, depth + 1);
            dump_stmt(f.then_block, depth + 1);
            if f.else_stmt != null {
                indent(depth);
                printf("else\n");
                dump_stmt(f.else_stmt, depth + 1);
            }
        }
        STMT_WHILE => {
            let StmtWhile* w = s.as(StmtWhile*);
            indent(depth);
            printf("while\n");
            dump_expr(w.cond, depth + 1);
            dump_stmt(w.body, depth + 1);
        }
        STMT_MATCH => {
            let StmtMatch* m = s.as(StmtMatch*);
            indent(depth);
            printf("match (%u arms)\n", m.narms);
            dump_expr(m.scrutinee, depth + 1);
            let mut i32 a = 0;
            while a < m.narms {
                indent(depth + 1);
                printf("arm");
                let mut i32 j = 0;
                while j < m.arms[a].nlabels {
                    if j == 0 {
                        printf(" ");
                    } else {
                        printf(",");
                    }
                    let Expr* label = m.arms[a].labels[j];
                    if label == null {
                        printf("_");
                    } else {
                        if label.kind == EXPR_NAME.as(i32) {
                            print_name(label.as(ExprText*).text, label.as(ExprText*).len);
                        } else {
                            printf("%llu", label.as(ExprLit*).ival);
                        }
                    }
                    j += 1;
                }
                printf("\n");
                dump_stmt(m.arms[a].body, depth + 2);
                a += 1;
            }
        }
        STMT_RETURN => {
            let StmtExpr* r = s.as(StmtExpr*);
            indent(depth);
            printf("return\n");
            if r.value != null {
                dump_expr(r.value, depth + 1);
            }
        }
        STMT_BREAK => {
            indent(depth);
            printf("break\n");
        }
        STMT_CONTINUE => {
            indent(depth);
            printf("continue\n");
        }
        STMT_EXPR => {
            let StmtExpr* x = s.as(StmtExpr*);
            indent(depth);
            printf("expr\n");
            dump_expr(x.value, depth + 1);
        }
        STMT_ASSIGN => {
            let StmtAssign* a = s.as(StmtAssign*);
            indent(depth);
            printf("assign %s\n", token_kind_name(a.op));
            dump_expr(a.target, depth + 1);
            dump_expr(a.value, depth + 1);
        }
        _ => {
            indent(depth);
            printf("<error-stmt>\n");
        }
    }
}

fn dump_signature(ItemFn* f, i32 depth) -> void {
    indent(depth);
    printf("fn ");
    print_name(f.name, f.name_len);
    printf("(");
    let mut i32 i = 0;
    while i < f.nparams {
        if i != 0 {
            printf(", ");
        }
        if f.params[i].is_mut != 0 {
            printf("mut ");
        }
        print_type(f.params[i].type);
        printf(" ");
        print_name(f.params[i].name, f.params[i].name_len);
        i += 1;
    }
    if f.is_variadic != 0 {
        if f.nparams != 0 {
            printf(", ...");
        } else {
            printf("...");
        }
    }
    printf(") -> ");
    print_type(f.ret);
    printf("\n");
}

fn dump_item(Item* it, i32 depth) -> void {
    if it == null {
        indent(depth);
        printf("<error-item>\n");
        return;
    }

    match it.kind {
        ITEM_FN => {
            let ItemFn* f = it.as(ItemFn*);
            dump_signature(f, depth);
            if f.has_body != 0 {
                dump_stmt(f.body, depth + 1);
            }
        }
        ITEM_STRUCT => {
            let ItemStruct* s = it.as(ItemStruct*);
            indent(depth);
            printf("struct ");
            print_name(s.name, s.name_len);
            printf("\n");
            let mut i32 i = 0;
            while i < s.nfields {
                indent(depth + 1);
                print_type(s.fields[i].type);
                printf(" ");
                print_name(s.fields[i].name, s.fields[i].name_len);
                printf("\n");
                i += 1;
            }
        }
        ITEM_ENUM => {
            let ItemEnum* e = it.as(ItemEnum*);
            indent(depth);
            printf("enum ");
            print_name(e.name, e.name_len);
            printf(" : %s\n", token_kind_name(e.base));
            let mut i32 i = 0;
            while i < e.nmembers {
                indent(depth + 1);
                print_name(e.members[i].name, e.members[i].name_len);
                if e.members[i].has_value != 0 {
                    printf(" = %llu", e.members[i].value);
                }
                printf("\n");
                i += 1;
            }
        }
        ITEM_GLOBAL => {
            let ItemGlobal* g = it.as(ItemGlobal*);
            indent(depth);
            printf("let ");
            if g.is_mut != 0 {
                printf("mut ");
            }
            print_type(g.type);
            printf(" ");
            print_name(g.name, g.name_len);
            printf("\n");
            if g.init != null {
                dump_expr(g.init, depth + 1);
            }
        }
        ITEM_EXTERN => {
            let ItemExtern* x = it.as(ItemExtern*);
            indent(depth);
            printf("extern ");
            print_quoted(x.abi, x.abi_len);
            printf("\n");
            let mut i32 i = 0;
            while i < x.nfns {
                dump_signature(x.fns[i].as(ItemFn*), depth + 1);
                i += 1;
            }
        }
        _ => {
            indent(depth);
            printf("<error-item>\n");
        }
    }
}

fn ast_dump(Program* prog) -> void {
    if prog == null {
        printf("<no program>\n");
        return;
    }
    printf("program %s (%u items)\n", prog.file, prog.nitems);
    let mut i32 i = 0;
    while i < prog.nitems {
        dump_item(prog.items[i], 1);
        i += 1;
    }
}
