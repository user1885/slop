# stage1/lexer.slop — the slop lexer, written in slop.
#
# This is the first piece of the compiler to be ported, and it is the honest
# test of whether v0 is sufficient: the C lexer leans on X-macros, unions,
# static tables and a preprocessor, and slop has none of those. What replaces
# them is written out, which is the point — the language is supposed to be
# small enough to implement itself, not comfortable.
#
# What had to change, and why:
#
#   The token kind, its spelling and its printable name were one X-macro list
#   in C. Here they are an enum and two functions. A table cannot be written
#   as a literal in v0 (no struct initializers), so the lookups are code.
#
#   Token has no union. slop has no unions at all, so the payload fields sit
#   side by side and only the one the kind names is meaningful.
#
#   Nothing is returned by value: a struct crosses a function boundary only
#   through a pointer, so lex_next fills a Token the caller owns.
#
# It is checked by diffing its output against the C lexer's `--tokens` on the
# same file. Agreement is the whole measure of progress here.

extern "c" {
    fn malloc(u64 size) -> void*;
    fn realloc(void* p, u64 size) -> void*;
    fn free(void* p) -> void;
    fn printf(u8* fmt, ...) -> i32;
    fn fprintf(void* stream, u8* fmt, ...) -> i32;
    fn fopen(u8* path, u8* mode) -> void*;
    fn fseek(void* f, i64 off, i32 whence) -> i32;
    fn ftell(void* f) -> i64;
    fn rewind(void* f) -> void;
    fn fread(void* buf, u64 size, u64 n, void* f) -> u64;
    fn fclose(void* f) -> i32;
    fn exit(i32 code) -> void;
    fn fdopen(i32 fd, u8* mode) -> void*;
    fn fflush(void* f) -> i32;
    fn snprintf(u8* buf, u64 size, u8* fmt, ...) -> i32;
}

# ------------------------------------------------------------- token kinds

enum Tok {
    TOK_EOF,
    TOK_ERROR,
    TOK_IDENT,
    TOK_INT,
    TOK_FLOAT,
    TOK_CHAR,
    TOK_STRING,

    TOK_KW_LET,
    TOK_KW_FN,
    TOK_KW_IF,
    TOK_KW_ELSE,
    TOK_KW_WHILE,
    TOK_KW_BREAK,
    TOK_KW_CONTINUE,
    TOK_KW_RETURN,
    TOK_KW_STRUCT,
    TOK_KW_ENUM,
    TOK_KW_EXTERN,
    TOK_KW_MUT,
    TOK_KW_AS,
    TOK_KW_SIZEOF,
    TOK_KW_MATCH,
    TOK_KW_TRUE,
    TOK_KW_FALSE,
    TOK_KW_NULL,
    TOK_KW_I8,
    TOK_KW_U8,
    TOK_KW_I32,
    TOK_KW_U32,
    TOK_KW_I64,
    TOK_KW_U64,
    TOK_KW_F32,
    TOK_KW_F64,
    TOK_KW_B8,
    TOK_KW_B32,
    TOK_KW_B64,
    TOK_KW_VOID,

    TOK_SHL_EQ,
    TOK_SHR_EQ,
    TOK_ELLIPSIS,
    TOK_AMP_AMP,
    TOK_PIPE_PIPE,
    TOK_SHL,
    TOK_SHR,
    TOK_LE,
    TOK_GE,
    TOK_EQ_EQ,
    TOK_BANG_EQ,
    TOK_PLUS_EQ,
    TOK_MINUS_EQ,
    TOK_STAR_EQ,
    TOK_SLASH_EQ,
    TOK_PERCENT_EQ,
    TOK_AMP_EQ,
    TOK_PIPE_EQ,
    TOK_CARET_EQ,
    TOK_ARROW,
    TOK_FAT_ARROW,
    TOK_PLUS,
    TOK_MINUS,
    TOK_STAR,
    TOK_SLASH,
    TOK_PERCENT,
    TOK_BANG,
    TOK_AMP,
    TOK_PIPE,
    TOK_CARET,
    TOK_TILDE,
    TOK_LT,
    TOK_GT,
    TOK_EQ,
    TOK_LPAREN,
    TOK_RPAREN,
    TOK_LBRACE,
    TOK_RBRACE,
    TOK_LBRACKET,
    TOK_RBRACKET,
    TOK_DOT,
    TOK_COMMA,
    TOK_SEMI,
    TOK_COLON,
}

# A token. No union, so every payload field is present and only the one the
# kind names carries anything.
struct Token {
    i32 kind;
    u64 ival;   # TOK_INT, TOK_CHAR
    f64 fval;   # TOK_FLOAT
    u8* text;   # into the source buffer; not NUL-terminated
    i32 len;
    i32 line;
    i32 col;
    u8* sval;   # TOK_STRING: decoded and NUL-terminated. TOK_ERROR: message.
    i32 slen;
}

struct Lexer {
    u8* file;
    u8* src;
    i64 pos;
    i64 len;
    i32 line;
    i64 line_start;
    i32 errors;
}

# -------------------------------------------------------------- characters

fn is_digit(u8 c) -> b8 {
    return c >= '0' && c <= '9';
}

fn is_hex_digit(u8 c) -> b8 {
    return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

fn hex_val(u8 c) -> u64 {
    if is_digit(c) {
        return (c - '0').as(u64);
    }
    return ((c | 0x20) - 'a' + 10).as(u64);
}

fn is_ident_start(u8 c) -> b8 {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

fn is_ident_cont(u8 c) -> b8 {
    return is_ident_start(c) || is_digit(c);
}

fn peek(Lexer* l, i64 off) -> u8 {
    if l.pos + off >= l.len {
        return 0;
    }
    return l.src[l.pos + off];
}

fn at_end(Lexer* l) -> b8 {
    return l.pos >= l.len;
}

# ----------------------------------------------------------------- strings

# Compares len bytes at s against the NUL-terminated kw.
fn name_is(u8* s, i32 len, u8* kw) -> b8 {
    let mut i32 i = 0;
    while i < len {
        if kw[i] == '\0' || s[i] != kw[i] {
            return false;
        }
        i += 1;
    }
    return kw[len] == '\0';
}

fn keyword_kind(u8* s, i32 len) -> i32 {
    # Ordered by nothing in particular: the first match wins and every
    # spelling is distinct, so order cannot matter.
    if name_is(s, len, "let") { return TOK_KW_LET.as(i32); }
    if name_is(s, len, "fn") { return TOK_KW_FN.as(i32); }
    if name_is(s, len, "if") { return TOK_KW_IF.as(i32); }
    if name_is(s, len, "else") { return TOK_KW_ELSE.as(i32); }
    if name_is(s, len, "while") { return TOK_KW_WHILE.as(i32); }
    if name_is(s, len, "break") { return TOK_KW_BREAK.as(i32); }
    if name_is(s, len, "continue") { return TOK_KW_CONTINUE.as(i32); }
    if name_is(s, len, "return") { return TOK_KW_RETURN.as(i32); }
    if name_is(s, len, "struct") { return TOK_KW_STRUCT.as(i32); }
    if name_is(s, len, "enum") { return TOK_KW_ENUM.as(i32); }
    if name_is(s, len, "extern") { return TOK_KW_EXTERN.as(i32); }
    if name_is(s, len, "mut") { return TOK_KW_MUT.as(i32); }
    if name_is(s, len, "as") { return TOK_KW_AS.as(i32); }
    if name_is(s, len, "sizeof") { return TOK_KW_SIZEOF.as(i32); }
    if name_is(s, len, "match") { return TOK_KW_MATCH.as(i32); }
    if name_is(s, len, "true") { return TOK_KW_TRUE.as(i32); }
    if name_is(s, len, "false") { return TOK_KW_FALSE.as(i32); }
    if name_is(s, len, "null") { return TOK_KW_NULL.as(i32); }
    if name_is(s, len, "i8") { return TOK_KW_I8.as(i32); }
    if name_is(s, len, "u8") { return TOK_KW_U8.as(i32); }
    if name_is(s, len, "i32") { return TOK_KW_I32.as(i32); }
    if name_is(s, len, "u32") { return TOK_KW_U32.as(i32); }
    if name_is(s, len, "i64") { return TOK_KW_I64.as(i32); }
    if name_is(s, len, "u64") { return TOK_KW_U64.as(i32); }
    if name_is(s, len, "f32") { return TOK_KW_F32.as(i32); }
    if name_is(s, len, "f64") { return TOK_KW_F64.as(i32); }
    if name_is(s, len, "b8") { return TOK_KW_B8.as(i32); }
    if name_is(s, len, "b32") { return TOK_KW_B32.as(i32); }
    if name_is(s, len, "b64") { return TOK_KW_B64.as(i32); }
    if name_is(s, len, "void") { return TOK_KW_VOID.as(i32); }
    return TOK_IDENT.as(i32);
}

fn token_kind_name(i32 kind) -> u8* {
    match kind {
        TOK_EOF => return "end of file";
        TOK_ERROR => return "error";
        TOK_IDENT => return "identifier";
        TOK_INT => return "int literal";
        TOK_FLOAT => return "float literal";
        TOK_CHAR => return "char literal";
        TOK_STRING => return "string literal";

        TOK_KW_LET => return "let";
        TOK_KW_FN => return "fn";
        TOK_KW_IF => return "if";
        TOK_KW_ELSE => return "else";
        TOK_KW_WHILE => return "while";
        TOK_KW_BREAK => return "break";
        TOK_KW_CONTINUE => return "continue";
        TOK_KW_RETURN => return "return";
        TOK_KW_STRUCT => return "struct";
        TOK_KW_ENUM => return "enum";
        TOK_KW_EXTERN => return "extern";
        TOK_KW_MUT => return "mut";
        TOK_KW_AS => return "as";
        TOK_KW_SIZEOF => return "sizeof";
        TOK_KW_MATCH => return "match";
        TOK_KW_TRUE => return "true";
        TOK_KW_FALSE => return "false";
        TOK_KW_NULL => return "null";
        TOK_KW_I8 => return "i8";
        TOK_KW_U8 => return "u8";
        TOK_KW_I32 => return "i32";
        TOK_KW_U32 => return "u32";
        TOK_KW_I64 => return "i64";
        TOK_KW_U64 => return "u64";
        TOK_KW_F32 => return "f32";
        TOK_KW_F64 => return "f64";
        TOK_KW_B8 => return "b8";
        TOK_KW_B32 => return "b32";
        TOK_KW_B64 => return "b64";
        TOK_KW_VOID => return "void";

        TOK_SHL_EQ => return "<<=";
        TOK_SHR_EQ => return ">>=";
        TOK_ELLIPSIS => return "...";
        TOK_AMP_AMP => return "&&";
        TOK_PIPE_PIPE => return "||";
        TOK_SHL => return "<<";
        TOK_SHR => return ">>";
        TOK_LE => return "<=";
        TOK_GE => return ">=";
        TOK_EQ_EQ => return "==";
        TOK_BANG_EQ => return "!=";
        TOK_PLUS_EQ => return "+=";
        TOK_MINUS_EQ => return "-=";
        TOK_STAR_EQ => return "*=";
        TOK_SLASH_EQ => return "/=";
        TOK_PERCENT_EQ => return "%=";
        TOK_AMP_EQ => return "&=";
        TOK_PIPE_EQ => return "|=";
        TOK_CARET_EQ => return "^=";
        TOK_ARROW => return "->";
        TOK_FAT_ARROW => return "=>";
        TOK_PLUS => return "+";
        TOK_MINUS => return "-";
        TOK_STAR => return "*";
        TOK_SLASH => return "/";
        TOK_PERCENT => return "%";
        TOK_BANG => return "!";
        TOK_AMP => return "&";
        TOK_PIPE => return "|";
        TOK_CARET => return "^";
        TOK_TILDE => return "~";
        TOK_LT => return "<";
        TOK_GT => return ">";
        TOK_EQ => return "=";
        TOK_LPAREN => return "(";
        TOK_RPAREN => return ")";
        TOK_LBRACE => return "{";
        TOK_RBRACE => return "}";
        TOK_LBRACKET => return "[";
        TOK_RBRACKET => return "]";
        TOK_DOT => return ".";
        TOK_COMMA => return ",";
        TOK_SEMI => return ";";
        TOK_COLON => return ":";
        _ => return "<invalid>";
    }
}

# ---------------------------------------------------------------- scanning

fn lexer_init(Lexer* l, u8* file, u8* src, i64 len) -> void {
    l.file = file;
    l.src = src;
    l.pos = 0;
    l.len = len;
    l.line = 1;
    l.line_start = 0;
    l.errors = 0;
}

fn skip_trivia(Lexer* l) -> void {
    while !at_end(l) {
        let u8 c = l.src[l.pos];
        if c == '\n' {
            l.pos += 1;
            l.line += 1;
            l.line_start = l.pos;
        } else {
            if c == ' ' || c == '\t' || c == '\r' {
                l.pos += 1;
            } else {
                if c == '#' {
                    while !at_end(l) && l.src[l.pos] != '\n' {
                        l.pos += 1;
                    }
                } else {
                    return;
                }
            }
        }
    }
}

fn set_error(Lexer* l, Token* t, u8* message) -> void {
    t.kind = TOK_ERROR.as(i32);
    t.sval = message;
    t.len = (l.pos - (t.text - l.src)).as(i32);
    l.errors += 1;
}

# Reads one char_lit/string_lit element. Returns the byte in *out, or false
# with *err set.
fn scan_char_unit(Lexer* l, u8* out, u8** err) -> b8 {
    if at_end(l) || l.src[l.pos] == '\n' {
        *err = "unterminated literal";
        return false;
    }

    let u8 c = l.src[l.pos];
    l.pos += 1;
    if c != '\\' {
        *out = c;
        return true;
    }

    if at_end(l) || l.src[l.pos] == '\n' {
        *err = "unterminated escape sequence";
        return false;
    }

    let u8 e = l.src[l.pos];
    l.pos += 1;
    match e {
        'n' => { *out = 10; return true; }
        'r' => { *out = 13; return true; }
        't' => { *out = 9; return true; }
        '0' => { *out = 0; return true; }
        '\\' => { *out = 92; return true; }
        '\'' => { *out = 39; return true; }
        '"' => { *out = 34; return true; }
        'x' => {
            if l.pos + 1 >= l.len || !is_hex_digit(l.src[l.pos]) || !is_hex_digit(l.src[l.pos + 1]) {
                *err = "\\x needs exactly two hex digits";
                return false;
            }
            *out = (hex_val(l.src[l.pos]) * 16 + hex_val(l.src[l.pos + 1])).as(u8);
            l.pos += 2;
            return true;
        }
        _ => {
            # The offending character goes in the message, so the diagnostic
            # names what it saw rather than describing the category.
            let u8* buf = malloc(48).as(u8*);
            snprintf(buf, 48, "unknown escape sequence '\\%c'", e.as(i32));
            *err = buf;
            return false;
        }
    }
}

fn lex_char(Lexer* l, Token* t) -> void {
    l.pos += 1;
    if !at_end(l) && l.src[l.pos] == '\'' {
        l.pos += 1;
        set_error(l, t, "empty character literal");
        return;
    }

    let mut u8 value = 0;
    let mut u8* err = null;
    if !scan_char_unit(l, &value, &err) {
        set_error(l, t, err);
        return;
    }
    if at_end(l) || l.src[l.pos] != '\'' {
        set_error(l, t, "unterminated character literal");
        return;
    }
    l.pos += 1;

    t.kind = TOK_CHAR.as(i32);
    t.ival = value.as(u64);
    t.len = (l.pos - (t.text - l.src)).as(i32);
}

fn lex_string(Lexer* l, Token* t) -> void {
    l.pos += 1;

    # A string cannot span a newline, so the rest of the line bounds the
    # decoded length: one allocation, no resizing.
    let mut i64 eol = l.pos;
    while eol < l.len && l.src[eol] != '\n' {
        eol += 1;
    }
    let u8* buf = malloc((eol - l.pos + 1).as(u64)).as(u8*);

    let mut i32 n = 0;
    let mut b8 done = false;
    while !done {
        if at_end(l) || l.src[l.pos] == '\n' {
            set_error(l, t, "unterminated string literal");
            return;
        }
        if l.src[l.pos] == '"' {
            l.pos += 1;
            done = true;
        } else {
            let mut u8 value = 0;
            let mut u8* err = null;
            if !scan_char_unit(l, &value, &err) {
                set_error(l, t, err);
                return;
            }
            buf[n] = value;
            n += 1;
        }
    }
    buf[n] = 0;

    t.kind = TOK_STRING.as(i32);
    t.sval = buf;
    t.slen = n;
    t.len = (l.pos - (t.text - l.src)).as(i32);
}

fn lex_number(Lexer* l, Token* t) -> void {
    let mut u64 v = 0;
    let mut b8 overflow = false;
    let i64 start = l.pos;

    if peek(l, 0) == '0' && peek(l, 1) == 'x' {
        l.pos += 2;
        if at_end(l) || !is_hex_digit(l.src[l.pos]) {
            set_error(l, t, "expected hex digits after '0x'");
            return;
        }
        while !at_end(l) && is_hex_digit(l.src[l.pos]) {
            let u64 d = hex_val(l.src[l.pos]);
            if v > (18446744073709551615 - d) / 16 {
                overflow = true;
            }
            v = v * 16 + d;
            l.pos += 1;
        }
    } else {
        while !at_end(l) && is_digit(l.src[l.pos]) {
            let u64 d = (l.src[l.pos] - '0').as(u64);
            if v > (18446744073709551615 - d) / 10 {
                overflow = true;
            }
            v = v * 10 + d;
            l.pos += 1;
        }

        # A dot only starts a fraction when a digit follows, so `1.as(f64)`
        # stays an int, a dot and a name.
        if !at_end(l) && l.src[l.pos] == '.' && is_digit(peek(l, 1)) {
            l.pos += 2;
            while !at_end(l) && is_digit(l.src[l.pos]) {
                l.pos += 1;
            }
            if !at_end(l) && is_ident_cont(l.src[l.pos]) {
                l.pos += 1;
                set_error(l, t, "unexpected character after float literal");
                return;
            }

            # Parse the fraction directly: v already holds the integer part.
            let mut f64 f = v.as(f64);
            let mut f64 scale = 1.0;
            let mut i64 i = start;
            while l.src[i] != '.' {
                i += 1;
            }
            i += 1;
            while i < l.pos {
                scale /= 10.0;
                f += (l.src[i] - '0').as(f64) * scale;
                i += 1;
            }

            t.kind = TOK_FLOAT.as(i32);
            t.fval = f;
            t.len = (l.pos - start).as(i32);
            return;
        }
    }

    if !at_end(l) && is_ident_cont(l.src[l.pos]) {
        l.pos += 1;
        set_error(l, t, "unexpected character after integer literal");
        return;
    }
    if overflow {
        set_error(l, t, "integer literal does not fit in 64 bits");
        return;
    }

    t.kind = TOK_INT.as(i32);
    t.ival = v;
    t.len = (l.pos - start).as(i32);
}

fn lex_ident(Lexer* l, Token* t) -> void {
    let i64 start = l.pos;
    while !at_end(l) && is_ident_cont(l.src[l.pos]) {
        l.pos += 1;
    }
    t.len = (l.pos - start).as(i32);
    t.kind = keyword_kind(t.text, t.len);
}

# Maximal munch, written out. The C lexer probes a table ordered longest
# first; here the order is the shape of the code, and the same rule holds:
# `<<=` before `<<` before `<=` before `<`.
fn lex_punct(Lexer* l, Token* t) -> void {
    let u8 c = peek(l, 0);
    let u8 c1 = peek(l, 1);
    let u8 c2 = peek(l, 2);
    let mut i32 kind = TOK_ERROR.as(i32);
    let mut i32 n = 1;

    match c {
        '<' => {
            if c1 == '<' && c2 == '=' { kind = TOK_SHL_EQ.as(i32); n = 3; }
            else { if c1 == '<' { kind = TOK_SHL.as(i32); n = 2; }
            else { if c1 == '=' { kind = TOK_LE.as(i32); n = 2; }
            else { kind = TOK_LT.as(i32); } } }
        }
        '>' => {
            if c1 == '>' && c2 == '=' { kind = TOK_SHR_EQ.as(i32); n = 3; }
            else { if c1 == '>' { kind = TOK_SHR.as(i32); n = 2; }
            else { if c1 == '=' { kind = TOK_GE.as(i32); n = 2; }
            else { kind = TOK_GT.as(i32); } } }
        }
        '.' => {
            if c1 == '.' && c2 == '.' { kind = TOK_ELLIPSIS.as(i32); n = 3; }
            else { kind = TOK_DOT.as(i32); }
        }
        '&' => {
            if c1 == '&' { kind = TOK_AMP_AMP.as(i32); n = 2; }
            else { if c1 == '=' { kind = TOK_AMP_EQ.as(i32); n = 2; }
            else { kind = TOK_AMP.as(i32); } }
        }
        '|' => {
            if c1 == '|' { kind = TOK_PIPE_PIPE.as(i32); n = 2; }
            else { if c1 == '=' { kind = TOK_PIPE_EQ.as(i32); n = 2; }
            else { kind = TOK_PIPE.as(i32); } }
        }
        '=' => {
            if c1 == '=' { kind = TOK_EQ_EQ.as(i32); n = 2; }
            else { if c1 == '>' { kind = TOK_FAT_ARROW.as(i32); n = 2; }
            else { kind = TOK_EQ.as(i32); } }
        }
        '!' => {
            if c1 == '=' { kind = TOK_BANG_EQ.as(i32); n = 2; }
            else { kind = TOK_BANG.as(i32); }
        }
        '-' => {
            if c1 == '>' { kind = TOK_ARROW.as(i32); n = 2; }
            else { if c1 == '=' { kind = TOK_MINUS_EQ.as(i32); n = 2; }
            else { kind = TOK_MINUS.as(i32); } }
        }
        '+' => {
            if c1 == '=' { kind = TOK_PLUS_EQ.as(i32); n = 2; }
            else { kind = TOK_PLUS.as(i32); }
        }
        '*' => {
            if c1 == '=' { kind = TOK_STAR_EQ.as(i32); n = 2; }
            else { kind = TOK_STAR.as(i32); }
        }
        '/' => {
            if c1 == '=' { kind = TOK_SLASH_EQ.as(i32); n = 2; }
            else { kind = TOK_SLASH.as(i32); }
        }
        '%' => {
            if c1 == '=' { kind = TOK_PERCENT_EQ.as(i32); n = 2; }
            else { kind = TOK_PERCENT.as(i32); }
        }
        '^' => {
            if c1 == '=' { kind = TOK_CARET_EQ.as(i32); n = 2; }
            else { kind = TOK_CARET.as(i32); }
        }
        '~' => kind = TOK_TILDE.as(i32);
        '(' => kind = TOK_LPAREN.as(i32);
        ')' => kind = TOK_RPAREN.as(i32);
        '{' => kind = TOK_LBRACE.as(i32);
        '}' => kind = TOK_RBRACE.as(i32);
        '[' => kind = TOK_LBRACKET.as(i32);
        ']' => kind = TOK_RBRACKET.as(i32);
        ',' => kind = TOK_COMMA.as(i32);
        ';' => kind = TOK_SEMI.as(i32);
        ':' => kind = TOK_COLON.as(i32);
        _ => {
            l.pos += 1;
            let u8* buf = malloc(48).as(u8*);
            if c >= 0x20 && c < 0x7F {
                snprintf(buf, 48, "unexpected character '%c'", c.as(i32));
            } else {
                snprintf(buf, 48, "unexpected byte 0x%02X", c.as(i32));
            }
            set_error(l, t, buf);
            return;
        }
    }

    l.pos += n.as(i64);
    t.kind = kind;
    t.len = n;
}

fn lex_next(Lexer* l, Token* t) -> void {
    skip_trivia(l);

    t.kind = TOK_EOF.as(i32);
    t.ival = 0;
    t.fval = 0.0;
    t.text = &l.src[l.pos];
    t.len = 0;
    t.line = l.line;
    t.col = (l.pos - l.line_start + 1).as(i32);
    t.sval = null;
    t.slen = 0;

    if at_end(l) {
        return;
    }

    let u8 c = l.src[l.pos];
    if is_ident_start(c) {
        lex_ident(l, t);
        return;
    }
    if is_digit(c) {
        lex_number(l, t);
        return;
    }
    if c == '\'' {
        lex_char(l, t);
        return;
    }
    if c == '"' {
        lex_string(l, t);
        return;
    }
    lex_punct(l, t);
}
