# Pins every statement form from GRAMMAR.md section 4, including the else-if
# chain (which nests an IfStmt rather than a Block), a bare `;`, a nested
# block, all eleven assignment operators, and match arms with several labels.

fn stmts(i32 n, i32* p, Point s) -> i32 {
    let mut i32 i = 0;
    let i32 fixed = 1;
    let mut i32 uninit;
    ;
    {
        let i32 inner = 1;
        {
            let i32 deeper = 2;
        }
    }

    if n > 0 {
        i = 1;
    } else if n < 0 {
        i = 2;
    } else {
        i = 3;
    }

    if n == 0 {
        i = 4;
    }

    while i < 10 {
        i += 1;
        if i == 5 {
            continue;
        }
        if i == 7 {
            break;
        }
    }

    # Assignment targets that sema will have to lvalue-check.
    i = 0;
    i += 1;
    i -= 1;
    i *= 2;
    i /= 2;
    i %= 3;
    i &= 1;
    i |= 1;
    i ^= 1;
    i <<= 1;
    i >>= 1;
    *p = 5;
    s.x = 6;
    p[0] = 7;

    # A bare expression is a statement too.
    call(n);

    match n {
        0 => return 0;
        1, 2 => i *= 2;
        'a' => i = 1;
        NAMED => {
            i = 2;
        }
        _ => {
        }
    }

    return i;
}

fn early_return() -> void {
    return;
}
